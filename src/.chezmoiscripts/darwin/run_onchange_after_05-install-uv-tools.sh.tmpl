#!/usr/bin/env bash

source "{{ .chezmoi.sourceDir }}/dot_local/lib/shell/utils.sh"

set-strict-mode

{{ $tools := concat .uv_tools.common (index .uv_tools .profile) -}}

# uv tools: {{ $tools | join ", " }}

p-header white "Installing uv tools..."

uv_shim="${PROTO_HOME:-$HOME/.proto}/shims/uv"
uv_bin="$(command -v uv || printf '%s' "$uv_shim")"

# A shim can exist even when its pinned version isn't installed.
if ! "$uv_bin" --version &>/dev/null; then
  p-header amber "uv not usable; installing with proto..."
  proto-install uv
  uv_bin="$uv_shim"

  if ! "$uv_bin" --version &>/dev/null; then
    p-header red "uv still not usable after proto install."
    exit 1
  fi
fi
{{ range $tools }}
"$uv_bin" tool install {{ . }}
{{- end }}

p-header green "uv tools installed..."
