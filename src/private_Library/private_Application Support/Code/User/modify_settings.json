{{- /* chezmoi:modify-template */ -}}
{{- $current := .chezmoi.stdin | trim | default "{}" | fromJsonc -}}
{{- $kubernetes := get $current "vs-kubernetes" | default dict -}}
{{- $_ := set $kubernetes "vs-kubernetes.suppress-helm-not-found-alerts" true -}}
{
	"[html]": {
		"editor.defaultFormatter": "vscode.html-language-features"
	},
	"[javascript]": {
		"editor.defaultFormatter": "oxc.oxc-vscode"
	},
	"[markdown]": {
		"editor.defaultFormatter": "oxc.oxc-vscode"
	},
	"[python]": {
		"editor.tabSize": 4,
		"editor.defaultFormatter": "charliermarsh.ruff"
	},
	"[typescript]": {
		"editor.defaultFormatter": "oxc.oxc-vscode"
	},
	"[typescriptreact]": {
		"editor.defaultFormatter": "oxc.oxc-vscode"
	},
	"[yaml]": {
		"editor.autoIndent": "advanced",
		"editor.defaultFormatter": "oxc.oxc-vscode"
	},
	"[rust]": {
		"editor.defaultFormatter": "rust-lang.rust-analyzer"
	},
	"[sql]": {
		"editor.defaultFormatter": "cweijan.vscode-postgresql-client2"
	},
	"[elixir]": {
		"editor.bracketPairColorization.enabled": false,
		"editor.defaultFormatter": "JakeBecker.elixir-ls"
	},
	"[gleam]": {
		"editor.defaultFormatter": "gleam.gleam"
	},
	"[scss]": {
		"editor.defaultFormatter": "oxc.oxc-vscode"
	},
	"[terraform]": {
		"editor.defaultFormatter": "hashicorp.terraform"
	},
	"[terraform-vars]": {
		"editor.defaultFormatter": "hashicorp.terraform"
	},
	"[json]": {
		"editor.defaultFormatter": "oxc.oxc-vscode"
	},
	"[github-actions-workflow]": {
		"editor.defaultFormatter": "redhat.vscode-yaml"
	},
	"[dockercompose]": {
		"editor.autoIndent": "advanced",
		"editor.defaultFormatter": "redhat.vscode-yaml",
		"editor.insertSpaces": true,
		"editor.quickSuggestions": {
			"comments": false,
			"other": true,
			"strings": true
		},
		"editor.tabSize": 2
	},
	"breadcrumbs.enabled": true,
	"diffEditor.ignoreTrimWhitespace": false,
	"editor.defaultFormatter": "oxc.oxc-vscode",
	// Enable Oxc in each project with "oxc.enable": true.
	"oxc.enable": false,
	"editor.fontFamily": "OverpassM Nerd Font Propo, Operator Mono, Menlo, Monaco, 'Courier New', monospace",
	"editor.fontSize": 13,
	"editor.formatOnPaste": true,
	"editor.formatOnSave": true,
	"editor.multiCursorModifier": "ctrlCmd",
	"editor.rulers": [80, 100],
	"editor.snippetSuggestions": "top",
	"editor.tabSize": 2,
	"editor.semanticHighlighting.enabled": true,
	"editor.tokenColorCustomizations": {
		"textMateRules": [
			/* COMMON */
			{
				"scope": "punctuation.definition.comment",
				"settings": {
					"fontStyle": "italic",
					"foreground": "#ff7bed"
				}
			},
			{
				"scope": "comment, comment.line.double-slash",
				"settings": {
					"fontStyle": "italic",
					"foreground": "#ff7bed"
				}
			},
			{
				"scope": "heading.2.markdown entity.name.section.markdown",
				"settings": {
					"foreground": "#ff9421"
				}
			},
			{
				"scope": "heading.3.markdown entity.name.section.markdown",
				"settings": {
					"foreground": "#83d440"
				}
			},
			{
				"scope": "heading.4.markdown entity.name.section.markdown",
				"settings": {
					"foreground": "#00d5ff"
				}
			},
			{
				"scope": "markup.quote",
				"settings": {
					"foreground": "#60a66f"
				}
			}
		]
	},
	"editor.wordWrap": "on",
	"editor.wrappingIndent": "deepIndent",
	"emmet.includeLanguages": {
		"javascript": "javascriptreact",
		"typescript": "typescriptreact"
	},
	"emmet.syntaxProfiles": {
		"js": {
			"attr_quotes": "single"
		},
		"jsx": {
			"attr_quotes": "single"
		},
		"ts": {
			"attr_quotes": "single"
		},
		"tsx": {
			"attr_quotes": "single"
		}
	},
	"emmet.triggerExpansionOnTab": true,
	"explorer.confirmDragAndDrop": false,
	"explorer.openEditors.visible": 1,
	"extensions.ignoreRecommendations": false,
	"files.associations": {
		"**/.github/**/*.yml": "github-actions-workflow",
		"*.mdx": "mdx",
		"Modelfile": "modelfile"
	},
	"files.insertFinalNewline": true,
	"files.trimFinalNewlines": true,
	"files.trimTrailingWhitespace": true,
	"git.allowForcePush": true,
	"git.confirmForcePush": false,
	"git.confirmSync": false,
	"git.rebaseWhenSync": true,
	"html.format.wrapLineLength": 90,
	"js/ts.updateImportsOnFileMove.enabled": "always",
	"jupyter.interactiveWindow.creationMode": "perFile",
	"liveServer.settings.donotShowInfoMsg": true,
	"npm.enableRunFromFolder": true,
	"twig-language-2.formatting": false,
	"security.workspace.trust.untrustedFiles": "open",
	"terminal.external.osxExec": "iTerm.app",
	"js/ts.tsdk.path": "./node_modules/typescript/lib",
	"js/ts.validate.enabled": true,
	"window.restoreWindows": "all",
	"workbench.colorCustomizations": {
		"editorCodeLens.foreground": "#787776e6",
		"editorCursor.foreground": "#00ff40",
		"notebook.cellBorderColor": "#111",
		"notebook.editorBackground": "#232629",
		"notebook.focusedCellBackground": "#232629",
		"notebook.focusedCellBorder": "#ff9500",
		"notebook.outputContainerBackgroundColor": "#16181a",
		"notebook.selectedCellBackground": "#232629"
	},
	"workbench.colorTheme": "One Monokai",
	"workbench.editor.closeOnFileDelete": false,
	"workbench.editor.highlightModifiedTabs": true,
	"workbench.enableExperiments": false,
	"workbench.startupEditor": "newUntitledFile",
	"write-good.languages": ["markdown", "md", "mdx", "plaintext"],
	"terminal.integrated.inheritEnv": false,
	"window.zoomLevel": 1,
	"jupyter.widgetScriptSources": ["jsdelivr.com", "unpkg.com"],
	"notebook.stickyScroll.enabled": true,
	"editor.stickyScroll.enabled": true,
	"workbench.tree.stickyScrollMaxItemCount": 5,
	"editor.inlineSuggest.suppressSuggestions": true,
	"explorer.confirmPasteNative": false,
	"gitlens.views.commitDetails.files.layout": "tree",
	"cSpell.userWords": ["initialised", "pulumi", "rustacean"],
	"jupyter.interactiveWindow.textEditor.executeSelection": true,
	"editor.fontLigatures": true,
	"cSpell.enabled": false,
	"code-livebook.livebookPort": 62259,
	"workbench.iconTheme": "material-icon-theme",
	"zenMode.centerLayout": false,
	"zenMode.hideLineNumbers": false,
	"zenMode.fullScreen": false,
	"workbench.editor.tabSizing": "shrink",
	"chat.agent.enabled": true,
	"editor.minimap.renderCharacters": false,
	"editor.minimap.showSlider": "always",
	"editor.minimap.enabled": false,
	"pgsql.serverGroups": [
		{
			"name": "Servers",
			"id": "EF8D0DF6-278B-48B9-9731-1CCF60D87F0C",
			"isDefault": true
		}
	],
	"pgsql.connections": [
		{
			"id": "42BB6A38-CD36-4F48-ABA6-44925DCC8890",
			"groupId": "EF8D0DF6-278B-48B9-9731-1CCF60D87F0C",
			"authenticationType": "SqlLogin",
			"connectTimeout": 15,
			"applicationName": "vscode-pgsql",
			"clientEncoding": "utf8",
			"sslmode": "prefer",
			"server": "localhost",
			"user": "admin",
			"port": "",
			"database": "local_agent_db",
			"password": "",
			"profileName": "local_agent_db, local_agent_db (admin)",
			"hostaddr": "",
			"expiresOn": 0,
			"profileSource": 0,
			"displayName": "local_agent_db, local_agent_db (admin)",
			"savePassword": true
		}
	],
	"database-client.autoSync": true,
	"pgsql.enableQueryHistoryCapture": false,
	"svgPreview.autoOpen": false,
	"docker.extension.enableComposeLanguageServer": false,
	"workbench.activityBar.location": "top",
	"diffEditor.codeLens": true,
	// The Kubernetes extension maintains this machine's tool paths here.
	"vs-kubernetes": {{ $kubernetes | toPrettyJson "\t" | trim | replace "\n" "\n\t" }},
	"harper.dialect": "British",
	"redhat.telemetry.enabled": false,
	"security.promptForLocalFileProtocolHandling": false,
	"testing.resultsView.layout": "treeLeft",
	"json.schemaDownload.trustedDomains": {
		"https://schemastore.azurewebsites.net/": true,
		"https://raw.githubusercontent.com/": true,
		"https://raw.githubusercontent.com/microsoft/vscode/": true,
		"https://raw.githubusercontent.com/devcontainers/spec/": true,
		"https://www.schemastore.org/": true,
		"https://json.schemastore.org/": true,
		"https://json-schema.org/": true,
		"https://developer.microsoft.com/json-schemas/": true,
		"https://biomejs.dev": true
	},
	"chat.disableAIFeatures": true,
	"yaml.disableSchemaDetection": [
		"**/.github/workflows/*.yml",
		"**/.github/workflows/*.yaml",
		"**/.gitea/workflows/*.yml",
		"**/.gitea/workflows/*.yaml",
		"**/.forgejo/workflows/*.yml",
		"**/.forgejo/workflows/*.yaml"
	],
	"python.analysis.typeCheckingMode": "standard",
	"diffEditor.renderSideBySide": true,
	"explorer.fileNesting.patterns": {
		"*.ts": "${capture}.js",
		"*.js": "${capture}.js.map, ${capture}.min.js, ${capture}.d.ts",
		"*.jsx": "${capture}.js",
		"*.tsx": "${capture}.ts",
		"tsconfig.json": "tsconfig.*.json",
		"package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml, bun.lockb, bun.lock",
		"Cargo.toml": "Cargo.lock",
		"*.sqlite": "${capture}.${extname}-*",
		"*.db": "${capture}.${extname}-*",
		"*.sqlite3": "${capture}.${extname}-*",
		"*.db3": "${capture}.${extname}-*",
		"*.sdb": "${capture}.${extname}-*",
		"*.s3db": "${capture}.${extname}-*"
	},
	"workbench.editorAssociations": {
		"{git,gitlens}:/**/*.livemd": "default",
		"*.db": "sqlite-viewer.option"
	},
	"claudeCode.hideOnboarding": true,
	"diffEditor.hideUnchangedRegions.enabled": true,
	"gitlens.graph.details.location": "auto"
}
