// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run the `open default settings` command
// from the command palette or from `Zed` application menu.
{
  "format_on_save": "on",
  "formatter": [
    {
      "language_server": {
        "name": "oxfmt"
      }
    }
  ],
  "diff_view_style": "split",
  "cli_default_open_behavior": "new_window",
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "git_panel": {
    "group_by": "staging",
    "tree_view": true,
    "dock": "left"
  },
  "base_keymap": "Atom",
  "icon_theme": {
    "mode": "dark",
    "light": "Catppuccin Frappé",
    "dark": "Catppuccin Frappé"
  },
  "agent": {
    "inline_assistant_model": {
      "provider": "openrouter",
      "model": "openrouter/free",
      "enable_thinking": false
    },
    "tool_permissions": {
      "tools": {
        "terminal": {
          "always_allow": [
            {
              "pattern": "^bunx\\s+oxlint(\\s|$)"
            }
          ]
        }
      }
    },
    "default_model": {
      "provider": "openrouter",
      "model": "openrouter/free",
      "enable_thinking": true
    },
    "dock": "right"
  },
  "ui_font_size": 16,
  "buffer_font_size": 16,
  "theme": {
    "mode": "dark",
    "light": "One Dark",
    "dark": "Catppuccin Frappé"
  },
  "buffer_font_family": "Monofur Nerd Font Propo",
  "tab_size": 2,
  "context_servers": {}
}
